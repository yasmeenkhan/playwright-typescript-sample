{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "description": "Typed Playwright framework for Sauce Demo: storageState auth, UI + API + a11y, tagged CI.",
  "scripts": {
    "test": "playwright test --project=chromium --project=api",
    "test:smoke": "playwright test --grep @smoke --project=chromium --project=api",
    "test:regression": "playwright test --project=chromium --project=firefox --project=api",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui --project=chromium --project=api",
    "report:allure": "npm run report:allure:generate && allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "sdet",
    "quality-engineering"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.36.0",
    "@estruyf/github-actions-reporter": "^1.12.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.12.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "zod": "^4.1.11"
  }
}
